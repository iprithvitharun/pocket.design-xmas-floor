{
  "manifest_version": 3,
  "name": "Pocket Christmas Floor",
  "version": "0.2.1",
  "description": "Fan-made overlay for pocket.design: drive a pixel cat around the office and take the elevator to a Christmas floor.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://pocket.design/*"],
      "js": ["src/catsprite.js", "src/xmasprops.js", "src/wardrobe.js", "src/decor.js", "src/arcade-sim.js", "src/arcade-art.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
